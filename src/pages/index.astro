---
import { content, profile } from '../content/portfolio';
import '../styles/global.css';
const copy = content.es;
---
<!doctype html>
<html lang="es"><head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="William Lucumí: líder técnico y desarrollador full stack en arquitectura, IA con RAG, ecommerce e integraciones empresariales." />
  <meta name="robots" content="index, follow" /><meta name="theme-color" content="#0b1220" />
  <meta property="og:title" content="William Lucumí | Líder Técnico, Full Stack e IA aplicada" /><meta property="og:description" content="Arquitectura de software, IA con RAG, ecommerce, pagos e integraciones empresariales." /><meta property="og:type" content="website" />
  <title>William Lucumí | Líder Técnico y Desarrollador Full Stack</title>
</head><body>
  <a class="skip-link" href="#main">Saltar al contenido</a>
  <header class="site-header"><a href="#inicio" class="brand" aria-label="William Lucumí, inicio">WL<span>.</span></a>
    <button class="menu-toggle" type="button" aria-controls="site-navigation" aria-expanded="false"><span data-text="menuLabel">{copy.menuLabel}</span><b aria-hidden="true">+</b></button>
    <nav id="site-navigation" aria-label="Navegación principal"><a href="#inicio" data-nav="0">Inicio</a><a href="#trabajo" data-nav="1">Casos</a><a href="#perfil" data-nav="2">Perfil</a><a href="#especialidades" data-nav="3">Soluciones</a><a href="#contacto" data-nav="4">Contacto</a></nav>
    <div class="language-switch" aria-label="Selector de idioma"><button class="active" type="button" data-language="es" aria-pressed="true">ES</button><span>/</span><button type="button" data-language="en" aria-pressed="false">EN</button></div>
  </header>
  <main id="main">
    <section id="inicio" class="hero section-shell"><div class="hero-copy reveal"><p class="eyebrow" data-text="heroEyebrow">{copy.heroEyebrow}</p><h1 data-text="heroTitle">{copy.heroTitle}</h1><p class="intro" data-text="heroDescription">{copy.heroDescription}</p><ul class="proof-list" aria-label="Áreas de especialidad">{copy.proof.map((item, index) => <li data-proof={index}>{item}</li>)}</ul><div class="hero-actions"><a href="#trabajo" class="button button-primary" data-text="projectsButton">{copy.projectsButton}<span aria-hidden="true">↘</span></a><a href="#contacto" class="button button-secondary" data-text="contactButton">{copy.contactButton}</a></div></div><div class="hero-mark reveal" data-system-map><p class="diagram-label" data-text="explorerLabel">{copy.explorerLabel}</p><p class="explorer-hint" data-text="explorerHint">{copy.explorerHint}</p><div class="explorer-tabs" role="group" aria-label="Casos de arquitectura">{copy.explorerCases.map((item, index) => <button type="button" data-explorer-tab={index} aria-pressed={index === 0 ? 'true' : 'false'}>{item.name}</button>)}</div><div class="explorer-flow" aria-live="polite">{copy.explorerCases[0].nodes.map((node, index) => <div class="flow-node"><span>0{index + 1}</span><strong data-flow-node={index}>{node}</strong></div>)}</div><div class="explorer-bottom"><p data-explorer-description>{copy.explorerCases[0].description}</p><a class="explorer-link" href="#case-0"><span data-text="explorerLink">{copy.explorerLink}</span> ↗</a></div></div></section>
    <section id="perfil" class="about section-shell reveal"><div class="section-label"><span>01</span><p data-text="aboutLabel">{copy.aboutLabel}</p></div><div class="about-content"><h2 data-text="aboutTitle">{copy.aboutTitle}</h2><p data-text="aboutText">{copy.aboutText}</p></div></section>
    <section class="impact section-shell"><div class="section-heading reveal"><div class="section-label"><span>02</span><p data-text="impactLabel">{copy.impactLabel}</p></div><h2 data-text="impactTitle">{copy.impactTitle}</h2></div><div class="impact-grid">{copy.impacts.map((impact, index) => <article class="impact-card reveal" data-impact={index}><strong>{impact[0]}</strong><p>{impact[1]}</p></article>)}</div></section>
    <section id="especialidades" class="specialties section-shell"><div class="section-heading reveal"><div class="section-label"><span>03</span><p data-text="specialtiesLabel">{copy.specialtiesLabel}</p></div><h2 data-text="specialtiesTitle">{copy.specialtiesTitle}</h2></div><div class="specialty-list">{copy.specialties.map((item, index) => <article class="specialty reveal" data-specialty={index}><span>0{index + 1}</span><h3>{item[0]}</h3><p>{item[1]}</p></article>)}</div></section>
    <section class="skills section-shell reveal"><div class="section-label"><span>04</span><p data-text="skillsLabel">{copy.skillsLabel}</p></div><div class="skills-content"><h2 data-text="skillsTitle">{copy.skillsTitle}</h2><div class="skill-groups">{copy.skillGroups.map((group, index) => <div class="skill-group" data-skill-group={index}><h3>{group[0]}</h3><ul>{group[1].map(skill => <li>{skill}</li>)}</ul></div>)}</div></div></section>
    <section id="experiencia" class="experience section-shell reveal"><div class="section-label"><span>05</span><p data-text="experienceLabel">{copy.experienceLabel}</p></div><div class="experience-content"><h2 data-text="experienceTitle">{copy.experienceTitle}</h2><ol class="roles-list">{copy.roles.map((role, index) => <li data-role={index}><strong>{role[0]}</strong><span>{role[1]}</span><p>{role[2]}</p></li>)}</ol></div></section>
    <section class="leadership section-shell reveal"><div class="section-label"><span>06</span><p data-text="leadershipLabel">{copy.leadershipLabel}</p></div><div class="leadership-content"><ol class="leadership-list">{copy.leadership.map((item, index) => <li data-leadership={index}><strong>{item[0]}</strong><p>{item[1]}</p></li>)}</ol></div></section>
    <section id="trabajo" class="projects section-shell"><div class="section-heading reveal"><div class="section-label"><span>07</span><p data-text="workLabel">{copy.workLabel}</p></div><h2 data-text="workTitle">{copy.workTitle}</h2></div><div class="project-list">{copy.projects.map((project, index) => <article id={`case-${index}`} class="project reveal" data-project={index}><div class="project-number">0{index + 1}</div><div class="project-title"><h3>{project[0]}</h3></div><div class="project-detail"><div class="project-visual" aria-hidden="true"><span>{index === 0 ? 'COMMERCE' : index === 1 ? 'SERVICE' : index === 2 ? 'CHECKOUT' : 'PROCESS'}</span><i></i><span>{index === 0 ? 'API' : index === 1 ? 'SOAP' : index === 2 ? 'PAYMENT' : 'APP'}</span><i></i><span>{index === 0 ? 'LOGISTICS' : index === 1 ? 'DATA' : index === 2 ? 'ORDER' : 'TRACKING'}</span></div><div class="project-ownership"><span data-text="ownershipLabel">{copy.ownershipLabel}</span><p data-ownership={index}>{copy.projectOwnership[index]}</p></div><dl>{copy.projectFields.map((field, fieldIndex) => <div><dt>{field}</dt><dd>{project[fieldIndex + 1]}</dd></div>)}</dl></div></article>)}</div></section>
    <section class="additional section-shell"><h2 data-text="additionalTitle">{copy.additionalTitle}</h2><div class="additional-list">{copy.additionalContributions.map((item, index) => <article data-additional={index}><h3>{item[0]}</h3><p>{item[1]}</p></article>)}</div></section>
    <section class="process section-shell"><div class="section-heading reveal"><div class="section-label"><span>08</span><p data-text="processLabel">{copy.processLabel}</p></div><h2 data-text="processTitle">{copy.processTitle}</h2></div><ol class="process-list">{copy.process.map(step => <li class="reveal"><span>{step[0]}</span><h3>{step[1]}</h3><p>{step[2]}</p></li>)}</ol></section>
    <section class="education section-shell reveal"><div class="section-label"><span>09</span><p data-text="educationLabel">{copy.educationLabel}</p></div><div class="education-content"><h2 data-text="educationTitle">{copy.educationTitle}</h2><ol>{copy.education.map((item, index) => <li data-education={index}><strong>{item[0]}</strong><span>{item[1]}</span></li>)}</ol></div></section>
    <section id="contacto" class="contact section-shell reveal"><div class="section-label"><span>10</span><p data-text="contactLabel">{copy.contactLabel}</p></div><div class="contact-content"><h2 data-text="contactTitle">{copy.contactTitle}</h2><p data-text="contactText">{copy.contactText}</p><div class="contact-links" aria-label="Canales de contacto"><a hidden class="contact-link" data-contact="email"><span>Email</span><b>↗</b></a><a hidden class="contact-link" data-contact="linkedin"><span>LinkedIn</span><b>↗</b></a><a hidden class="contact-link" data-contact="github"><span>GitHub</span><b>↗</b></a><a hidden class="contact-link" data-contact="resumeUrl"><span>CV</span><b>↓</b></a><p class="contact-pending" data-text="pending">{copy.pending}</p></div></div></section>
  </main><footer><p>© {new Date().getFullYear()} {profile.name}</p><p data-text="footer">{copy.footer}</p></footer>
  <script define:vars={{ content, profile }}>
    const setLanguage = (next) => { const data = content[next]; document.documentElement.lang = next; document.title = next === 'es' ? 'William Lucumí | Desarrollo e integraciones' : 'William Lucumí | Development & integrations'; document.querySelectorAll('[data-text]').forEach(el => el.textContent = data[el.dataset.text]); document.querySelectorAll('[data-nav]').forEach(el => el.textContent = data.nav[Number(el.dataset.nav)]); document.querySelectorAll('[data-language]').forEach(button => { const active = button.dataset.language === next; button.classList.toggle('active', active); button.setAttribute('aria-pressed', String(active)); }); document.querySelectorAll('[data-proof]').forEach(el => el.textContent = data.proof[Number(el.dataset.proof)]); document.querySelectorAll('[data-impact]').forEach(el => { const item = data.impacts[Number(el.dataset.impact)]; el.querySelector('strong').textContent = item[0]; el.querySelector('p').textContent = item[1]; }); document.querySelectorAll('[data-signal]').forEach((button, index) => { button.dataset.signal = data.signals[index]; button.setAttribute('aria-pressed', 'false'); }); delete document.querySelector('[data-system-map]').dataset.active; document.querySelectorAll('[data-specialty]').forEach(el => { const item = data.specialties[Number(el.dataset.specialty)]; el.querySelector('h3').textContent = item[0]; el.querySelector('p').textContent = item[1]; }); document.querySelectorAll('[data-skill-group]').forEach(el => { const item = data.skillGroups[Number(el.dataset.skillGroup)]; el.querySelector('h3').textContent = item[0]; el.querySelector('ul').innerHTML = item[1].map(skill => `<li>${skill}</li>`).join(''); }); document.querySelectorAll('[data-role]').forEach(el => { const item = data.roles[Number(el.dataset.role)]; el.querySelector('strong').textContent = item[0]; el.querySelector('span').textContent = item[1]; el.querySelector('p').textContent = item[2]; }); document.querySelectorAll('[data-leadership]').forEach(el => { const item = data.leadership[Number(el.dataset.leadership)]; el.querySelector('strong').textContent = item[0]; el.querySelector('p').textContent = item[1]; }); document.querySelectorAll('[data-project]').forEach(el => { const item = data.projects[Number(el.dataset.project)]; el.querySelector('h3').textContent = item[0]; el.querySelectorAll('dt').forEach((dt, i) => dt.textContent = data.projectFields[i]); el.querySelectorAll('dd').forEach((dd, i) => dd.textContent = item[i + 1]); }); document.querySelectorAll('.process-list li').forEach((el, i) => { const item = data.process[i]; el.querySelector('span').textContent = item[0]; el.querySelector('h3').textContent = item[1]; el.querySelector('p').textContent = item[2]; }); document.querySelectorAll('[data-education]').forEach(el => { const item = data.education[Number(el.dataset.education)]; el.querySelector('strong').textContent = item[0]; el.querySelector('span').textContent = item[1]; }); };
    const menuToggle = document.querySelector('.menu-toggle'); const navigation = document.querySelector('#site-navigation'); menuToggle.addEventListener('click', () => { const open = menuToggle.getAttribute('aria-expanded') === 'true'; menuToggle.setAttribute('aria-expanded', String(!open)); navigation.classList.toggle('is-open', !open); }); navigation.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menuToggle.setAttribute('aria-expanded', 'false'); navigation.classList.remove('is-open'); }));
    document.querySelectorAll('[data-language]').forEach(button => button.addEventListener('click', () => setLanguage(button.dataset.language)));
    document.querySelectorAll('[data-language]').forEach(button => button.addEventListener('click', () => { const language = button.dataset.language; document.querySelectorAll('[data-explorer-tab]').forEach((tab, i) => tab.textContent = content[language].explorerCases[i].name); document.querySelectorAll('[data-ownership]').forEach((element, i) => element.textContent = content[language].projectOwnership[i]); const active = [...document.querySelectorAll('[data-explorer-tab]')].findIndex(tab => tab.getAttribute('aria-pressed') === 'true'); selectExplorer(Math.max(0, active), language); document.querySelector('meta[name="description"]').content = language === 'es' ? 'William Lucumí: líder técnico y desarrollador full stack en arquitectura, ecommerce e integraciones empresariales.' : 'William Lucumí: technical leader and full stack developer in software architecture, ecommerce, and enterprise integrations.'; }));
    const main = document.querySelector('main'); const about = document.querySelector('#perfil'); main.insertBefore(document.querySelector('.impact'), about); main.insertBefore(document.querySelector('#trabajo'), about); main.insertBefore(document.querySelector('.additional'), about); document.querySelectorAll('main > section .section-label > span').forEach((number, index) => number.textContent = String(index + 1).padStart(2, '0'));
    document.querySelectorAll('[data-project]').forEach((project, index) => { const decision = document.createElement('div'); decision.className = 'project-decision'; const label = document.createElement('span'); label.textContent = content.es.decisionLabel; const detail = document.createElement('p'); detail.textContent = content.es.projectDecisions[index]; decision.append(label, detail); project.querySelector('.project-detail').insertBefore(decision, project.querySelector('dl')); });
    document.querySelectorAll('[data-language]').forEach(button => button.addEventListener('click', () => { const data = content[button.dataset.language]; document.querySelectorAll('.project-decision').forEach((decision, index) => { decision.querySelector('span').textContent = data.decisionLabel; decision.querySelector('p').textContent = data.projectDecisions[index]; }); }));
    document.querySelectorAll('[data-language]').forEach(button => button.addEventListener('click', () => { const data = content[button.dataset.language]; document.querySelectorAll('[data-additional]').forEach((item, index) => { item.querySelector('h3').textContent = data.additionalContributions[index][0]; item.querySelector('p').textContent = data.additionalContributions[index][1]; }); }));
    document.querySelectorAll('[data-language]').forEach(button => button.addEventListener('click', () => { const english = button.dataset.language === 'en'; document.title = english ? 'William Lucumí | Technical Leader & Full Stack Developer' : 'William Lucumí | Líder Técnico y Desarrollador Full Stack'; document.querySelector('meta[property="og:title"]').content = document.title; document.querySelector('meta[property="og:description"]').content = english ? 'Software architecture, ecommerce, payments, and enterprise integrations.' : 'Arquitectura de software, ecommerce, pagos e integraciones empresariales.'; }));
    const selectExplorer = (index, language) => { const selected = content[language].explorerCases[index]; document.querySelectorAll('[data-explorer-tab]').forEach((button, i) => button.setAttribute('aria-pressed', String(i === index))); document.querySelectorAll('[data-flow-node]').forEach((node, i) => node.textContent = selected.nodes[i]); document.querySelector('[data-explorer-description]').textContent = selected.description; document.querySelector('.explorer-link').href = `#${selected.target}`; }; document.querySelectorAll('[data-explorer-tab]').forEach(button => button.addEventListener('click', () => selectExplorer(Number(button.dataset.explorerTab), document.documentElement.lang)));
    document.querySelectorAll('[data-contact]').forEach(link => { const key = link.dataset.contact; const value = profile[key]; if (value) { link.hidden = false; link.href = key === 'email' ? `mailto:${value}` : value; if (key === 'resumeUrl') link.download = 'CV-William-Lucumi.pdf'; else if (key !== 'email') { link.target = '_blank'; link.rel = 'noopener noreferrer'; } document.querySelector('.contact-pending').hidden = true; } });
    const observer = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); }), { threshold: .12 }); document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
</body></html>
